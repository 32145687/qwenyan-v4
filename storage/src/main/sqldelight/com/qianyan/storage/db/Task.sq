-- P8.1 · Task / Checkpoint 持久化（Schema v2）
-- Task 表只表达当前 Task 领域模型（TaskModels.kt）所需的持久化信息；禁止提前加入
-- Agent / Tool / Orchestrator / Provider / Knowledge 专用字段（P8.1 范围外，P8 Preflight 约束）。
-- 状态一律以 TEXT 存枚举名（TaskType / TaskStatus），与领域枚举一一对应，禁止字符串随意模拟状态。
-- 持久化约束：Task.revision_count ∈ [0,3]；Checkpoint.revision ∈ [1,3]；
--   Checkpoint (task_id, revision) 唯一 —— 每个 Task 至多 3 个 revision。
--   revision 上限的完整状态机管理属于 P8.2（TaskManager），P8.1 仅负责持久化约束。

CREATE TABLE Task (
    task_id         TEXT NOT NULL PRIMARY KEY,
    type            TEXT NOT NULL,               -- TaskType 枚举名
    status          TEXT NOT NULL,               -- TaskStatus 枚举名
    progress        REAL NOT NULL DEFAULT 0,     -- 0.0-1.0（DB REAL，边界恢复 Float）
    revision_count  INTEGER NOT NULL DEFAULT 0 CHECK (revision_count BETWEEN 0 AND 3),
    error           TEXT,                        -- 失败原因，可空
    created_at      INTEGER NOT NULL,            -- epoch 毫秒
    updated_at      INTEGER NOT NULL             -- epoch 毫秒
);

CREATE TABLE Checkpoint (
    checkpoint_id   TEXT NOT NULL PRIMARY KEY,
    task_id         TEXT NOT NULL,
    revision        INTEGER NOT NULL CHECK (revision BETWEEN 1 AND 3),
    stage           TEXT NOT NULL,               -- 恢复点：阶段标识
    snapshot        TEXT,                        -- JSON（JsonObject）或 NULL
    created_at      INTEGER NOT NULL,            -- epoch 毫秒
    UNIQUE (task_id, revision),
    FOREIGN KEY (task_id) REFERENCES Task(task_id)
);

insertTask:
INSERT INTO Task(task_id, type, status, progress, revision_count, error, created_at, updated_at)
VALUES (:task_id, :type, :status, :progress, :revision_count, :error, :created_at, :updated_at);

getTaskById:
SELECT * FROM Task WHERE task_id = :task_id;

updateTask:
UPDATE Task
SET type = :type, status = :status, progress = :progress,
    revision_count = :revision_count, error = :error, updated_at = :updated_at
WHERE task_id = :task_id;

deleteTask:
DELETE FROM Task WHERE task_id = :task_id;

deleteCheckpointsByTask:
DELETE FROM Checkpoint WHERE task_id = :task_id;

insertCheckpoint:
INSERT INTO Checkpoint(checkpoint_id, task_id, revision, stage, snapshot, created_at)
VALUES (:checkpoint_id, :task_id, :revision, :stage, :snapshot, :created_at);

selectCheckpointsByTask:
SELECT * FROM Checkpoint WHERE task_id = :task_id ORDER BY revision;

selectLatestCheckpoint:
SELECT * FROM Checkpoint WHERE task_id = :task_id ORDER BY revision DESC LIMIT 1;
