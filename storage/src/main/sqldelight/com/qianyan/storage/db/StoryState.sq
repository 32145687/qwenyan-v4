-- Qianyan Storage · Schema v5（P12.1.1 · Story State Persistence）
-- StoryWorldContextResolver 的持久化底座：6 张故事上下文表 + scope 隔离查询。
-- 约束（与既有 P12.0 约定一致）：
--   - 每张表均带 novel_id + variant_id(NULL=Original) + scope 三列；
--   - 查询一律按 novel+variant 隔离：Original ← variant_id IS NULL；Variant ← variant_id=:variant_id，不混 scope；
--   - 复杂嵌套列表/对象用 JSON 字符串列（不建关联表），ID 一律 TEXT(UUID)，时间 INTEGER(epoch ms)。
--     Original 只读约束由更高层校验，此处仅暴露写入方法。

CREATE TABLE Character (
    character_id  TEXT NOT NULL PRIMARY KEY,
    novel_id      TEXT NOT NULL,
    variant_id    TEXT,
    scope         TEXT NOT NULL,             -- VariantScope 枚举名
    name          TEXT NOT NULL,
    personality   TEXT NOT NULL DEFAULT '[]',-- JSON List<String>
    goals         TEXT NOT NULL DEFAULT '[]',-- v27：JSON List<String>（此前丢弃）
    fears         TEXT NOT NULL DEFAULT '[]',-- v27：JSON List<String>
    description   TEXT NOT NULL DEFAULT '',  -- v27：String（默认空串）
    created_at    INTEGER NOT NULL,          -- epoch 毫秒
    updated_at    INTEGER NOT NULL,
    FOREIGN KEY (novel_id) REFERENCES Novel(novel_id)
);

CREATE TABLE CharacterState (
    state_id           TEXT NOT NULL PRIMARY KEY,
    character_id       TEXT NOT NULL,
    novel_id           TEXT NOT NULL,
    variant_id         TEXT,
    scope              TEXT NOT NULL,        -- VariantScope 枚举名
    chapter_id         TEXT,
    timeline_position  TEXT,                 -- TimelinePosition JSON 或 NULL
    snapshot_type      TEXT NOT NULL,        -- SnapshotType 枚举名
    physical           TEXT NOT NULL DEFAULT '{}', -- PhysicalState(label/details) JSON
    emotional          TEXT NOT NULL DEFAULT '{}', -- EmotionalState(label/intensity) JSON
    current_goal       TEXT,
    location           TEXT,                  -- v27：LocationId?（NULL=未定位）
    current_motivation TEXT,                  -- v27：String?（NULL=无）
    relationships      TEXT NOT NULL DEFAULT '[]', -- v27：JSON List<RelationshipSnapshot>
    known_facts        TEXT NOT NULL DEFAULT '[]', -- v27：JSON List<KnowledgeId>
    unknown_facts      TEXT NOT NULL DEFAULT '[]', -- v27：JSON List<KnowledgeId>
    abilities          TEXT NOT NULL DEFAULT '[]', -- v27：JSON List<AbilitySnapshot>
    source             TEXT NOT NULL DEFAULT 'INFERRED', -- v27：StateSource 枚举名
    created_at         INTEGER NOT NULL,
    FOREIGN KEY (novel_id) REFERENCES Novel(novel_id)
);

CREATE TABLE WorldRule (
    rule_id    TEXT NOT NULL PRIMARY KEY,
    world_id   TEXT NOT NULL,
    novel_id   TEXT NOT NULL,
    variant_id TEXT,
    scope      TEXT NOT NULL,                -- VariantScope 枚举名
    content    TEXT NOT NULL,
    category   TEXT NOT NULL DEFAULT '',
    FOREIGN KEY (novel_id) REFERENCES Novel(novel_id)
);

CREATE TABLE Event (
    event_id    TEXT NOT NULL PRIMARY KEY,
    novel_id    TEXT NOT NULL,
    variant_id  TEXT,
    scope       TEXT NOT NULL,               -- VariantScope 枚举名
    name        TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    type        TEXT NOT NULL,               -- EventType 枚举名
    importance  INTEGER NOT NULL DEFAULT 5,
    when_json   TEXT,                        -- TimelinePosition JSON 或 NULL
    who         TEXT NOT NULL DEFAULT '[]',  -- JSON List<CharacterId>
    what        TEXT NOT NULL DEFAULT '',    -- v27：String（默认空串）
    where_json  TEXT NOT NULL DEFAULT '[]',  -- v27：JSON List<LocationId>（领域 where；SQL 保留字 → _json）
    cause       TEXT NOT NULL DEFAULT '[]',  -- v27：JSON List<EventId>
    consequence TEXT NOT NULL DEFAULT '[]',  -- v27：JSON List<EventId>
    participants TEXT NOT NULL DEFAULT '[]', -- v27：JSON List<EventParticipant>
    evidence    TEXT NOT NULL DEFAULT '[]',  -- v27：JSON List<Evidence>
    fact_level  TEXT NOT NULL DEFAULT 'EXPLICIT', -- v27：FactLevel 枚举名
    chapter_id  TEXT,
    status      TEXT NOT NULL,               -- EventStatus 枚举名
    created_at  INTEGER NOT NULL,            -- epoch 毫秒
    FOREIGN KEY (novel_id) REFERENCES Novel(novel_id)
);

CREATE TABLE TimelineEntry (
    timeline_id TEXT NOT NULL PRIMARY KEY,
    novel_id    TEXT NOT NULL,
    variant_id  TEXT,
    scope       TEXT NOT NULL,               -- VariantScope 枚举名
    position    TEXT NOT NULL,               -- TimelinePosition JSON
    event_id    TEXT,
    description TEXT NOT NULL DEFAULT '',
    chapter_id  TEXT,
    FOREIGN KEY (novel_id) REFERENCES Novel(novel_id)
);

-- P12.1.1/P13 LCL-C：Foreshadow（`state` 为唯一规范源；`resolved` 兼容列 = state∈{RESOLVED,ABANDONED}，由写入方保证一致）
CREATE TABLE Foreshadow (
    foreshadow_id        TEXT NOT NULL PRIMARY KEY,
    novel_id             TEXT NOT NULL,
    variant_id           TEXT,
    scope                TEXT NOT NULL,             -- VariantScope 枚举名
    chapter_id           TEXT,
    content              TEXT NOT NULL,
    resolved             INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,  -- 兼容列（state 派生一致性）
    state                TEXT NOT NULL DEFAULT 'PLANTED',                -- P13 LCL-C：ForeshadowLifecycleState
    updated_at           INTEGER NOT NULL DEFAULT 0,                     -- P13 LCL-C：最近迁移时间
    last_transition_reason TEXT,                                         -- P13 LCL-C：最近迁移原因（可空）
    payoff_chapter_id    TEXT,                                           -- P13 LCL-C：兑现章节（仅 RESOLVED）
    created_at           INTEGER NOT NULL,
    FOREIGN KEY (novel_id) REFERENCES Novel(novel_id)
);

-- P13 LCL-D：Reveal = 向读者揭示信息的运行时 Story State fact（READER only；无 revealedTo）
CREATE TABLE Reveal (
    reveal_id      TEXT NOT NULL PRIMARY KEY,
    novel_id       TEXT NOT NULL,
    variant_id     TEXT,
    scope          TEXT NOT NULL,           -- VariantScope 枚举名
    chapter_id     TEXT,
    information_id TEXT NOT NULL,           -- 被揭示信息/知识事实的引用（不搭建 Knowledge System）
    occurred_at    INTEGER NOT NULL,        -- epoch 毫秒
    reason         TEXT,
    created_at     INTEGER NOT NULL,
    FOREIGN KEY (novel_id) REFERENCES Novel(novel_id)
);
CREATE INDEX IF NOT EXISTS idx_reveal_scope ON Reveal(novel_id, variant_id, occurred_at, reveal_id);

-- P13 LCL-D (D1)：Event / Foreshadow / TimelineEntry 的 (novel_id, variant_id) scope 索引
CREATE INDEX IF NOT EXISTS idx_event_scope ON Event(novel_id, variant_id);
CREATE INDEX IF NOT EXISTS idx_foreshadow_scope ON Foreshadow(novel_id, variant_id);
CREATE INDEX IF NOT EXISTS idx_timeline_scope ON TimelineEntry(novel_id, variant_id);
insertCharacter:
INSERT OR REPLACE INTO Character(character_id, novel_id, variant_id, scope, name, personality, goals, fears, description, created_at, updated_at)
VALUES (:character_id, :novel_id, :variant_id, :scope, :name, :personality, :goals, :fears, :description, :created_at, :updated_at);

getCharacterById:
SELECT * FROM Character WHERE character_id = :character_id;

listCharactersByScope:
SELECT * FROM Character WHERE novel_id = :novel_id AND variant_id IS :variant_id ORDER BY name ASC, character_id ASC;

-- ============================================================
-- CharacterState
-- ============================================================
insertCharacterState:
INSERT OR REPLACE INTO CharacterState(state_id, character_id, novel_id, variant_id, scope, chapter_id, timeline_position, snapshot_type, physical, emotional, current_goal, location, current_motivation, relationships, known_facts, unknown_facts, abilities, source, created_at)
VALUES (:state_id, :character_id, :novel_id, :variant_id, :scope, :chapter_id, :timeline_position, :snapshot_type, :physical, :emotional, :current_goal, :location, :current_motivation, :relationships, :known_facts, :unknown_facts, :abilities, :source, :created_at);

getCharacterStateById:
SELECT * FROM CharacterState WHERE state_id = :state_id;

listCharacterStatesByScope:
SELECT * FROM CharacterState WHERE novel_id = :novel_id AND variant_id IS :variant_id ORDER BY created_at ASC, state_id ASC;

-- ============================================================
-- WorldRule
-- ============================================================
insertWorldRule:
INSERT OR REPLACE INTO WorldRule(rule_id, world_id, novel_id, variant_id, scope, content, category)
VALUES (:rule_id, :world_id, :novel_id, :variant_id, :scope, :content, :category);

getWorldRuleById:
SELECT * FROM WorldRule WHERE rule_id = :rule_id;

listWorldRulesByScope:
SELECT * FROM WorldRule WHERE novel_id = :novel_id AND variant_id IS :variant_id ORDER BY category ASC, rule_id ASC;

-- ============================================================
-- Event
-- ============================================================
insertEvent:
INSERT OR REPLACE INTO Event(event_id, novel_id, variant_id, scope, name, description, type, importance, when_json, who, what, where_json, cause, consequence, participants, evidence, fact_level, chapter_id, status, created_at)
VALUES (:event_id, :novel_id, :variant_id, :scope, :name, :description, :type, :importance, :when_json, :who, :what, :where_json, :cause, :consequence, :participants, :evidence, :fact_level, :chapter_id, :status, :created_at);

getEventById:
SELECT * FROM Event WHERE event_id = :event_id;

listEventsByScope:
SELECT * FROM Event WHERE novel_id = :novel_id AND variant_id IS :variant_id ORDER BY name ASC, event_id ASC;

-- ============================================================
-- TimelineEntry
-- ============================================================
insertTimelineEntry:
INSERT OR REPLACE INTO TimelineEntry(timeline_id, novel_id, variant_id, scope, position, event_id, description, chapter_id)
VALUES (:timeline_id, :novel_id, :variant_id, :scope, :position, :event_id, :description, :chapter_id);

getTimelineEntryById:
SELECT * FROM TimelineEntry WHERE timeline_id = :timeline_id;

listTimelineEntriesByScope:
SELECT * FROM TimelineEntry WHERE novel_id = :novel_id AND variant_id IS :variant_id ORDER BY position ASC, timeline_id ASC;

-- ============================================================
-- Foreshadow
-- ============================================================
insertForeshadow:
INSERT OR REPLACE INTO Foreshadow(foreshadow_id, novel_id, variant_id, scope, chapter_id, content, resolved, state, updated_at, last_transition_reason, payoff_chapter_id, created_at)
VALUES (:foreshadow_id, :novel_id, :variant_id, :scope, :chapter_id, :content, :resolved, :state, :updated_at, :last_transition_reason, :payoff_chapter_id, :created_at);

getForeshadowById:
SELECT * FROM Foreshadow WHERE foreshadow_id = :foreshadow_id;

listForeshadowsByScope:
SELECT * FROM Foreshadow WHERE novel_id = :novel_id AND variant_id IS :variant_id ORDER BY created_at ASC, foreshadow_id ASC;

-- ============================================================
-- Reveal（P13 LCL-D；READER only）
-- ============================================================
insertReveal:
INSERT OR REPLACE INTO Reveal(reveal_id, novel_id, variant_id, scope, chapter_id, information_id, occurred_at, reason, created_at)
VALUES (:reveal_id, :novel_id, :variant_id, :scope, :chapter_id, :information_id, :occurred_at, :reason, :created_at);

getRevealById:
SELECT * FROM Reveal WHERE reveal_id = :reveal_id;

listRevealsByScope:
SELECT * FROM Reveal WHERE novel_id = :novel_id AND variant_id IS :variant_id ORDER BY occurred_at ASC, reveal_id ASC;

-- P13 LCL-C：条件状态迁移（仅当当前 state == expected_state 时更新；并发/状态不匹配即 affect 0 行）
transitionForeshadowState:
UPDATE Foreshadow
SET state = :state, updated_at = :updated_at,
    last_transition_reason = :last_transition_reason, payoff_chapter_id = :payoff_chapter_id,
    resolved = :resolved
WHERE foreshadow_id = :foreshadow_id AND state = :expected_state;

-- 紧接上一 DML 语句后调用，返回其影响行数（用于区分 不存在 / expectedState 不匹配 / 成功）
lastAffectedRows:
SELECT changes() AS n;