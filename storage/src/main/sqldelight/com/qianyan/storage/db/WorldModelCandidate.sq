-- Phase 3 · World Model Update：候选事实持久化（CandidateFact，v28；迁移见 27.sqm）。
-- 生命周期与来源契约见 27.sqm 头注与 com.qianyan.model.worldmodel.CandidateFactModels。

CREATE TABLE CandidateFact (
    candidate_id       TEXT NOT NULL PRIMARY KEY,
    history_id         TEXT NOT NULL,        -- 来源 CommitHistory.history_id
    commit_id          TEXT NOT NULL,        -- 来源 CommitHistory.commit_id
    novel_id           TEXT NOT NULL,
    variant_id         TEXT,                 -- NULL=Original
    scope              TEXT NOT NULL,        -- VariantScope 枚举名
    chapter_id         TEXT,                 -- 来源章节（Commit target）
    kind               TEXT NOT NULL,        -- CandidateFactKind 枚举名（当前仅 EVENT）
    operation          TEXT NOT NULL,        -- ADD / UPDATE / REMOVE
    fact_name          TEXT NOT NULL,        -- 身份键（冲突判定用）
    summary            TEXT NOT NULL,        -- 候选事实内容摘要
    source_excerpt     TEXT NOT NULL,        -- 来源正文片段（必须包含于提交后正文，确定性校验）
    reason             TEXT NOT NULL DEFAULT '',  -- LLM 给出的提取依据
    status             TEXT NOT NULL,        -- PENDING / ACCEPTED / REJECTED / CONFLICT
    decision_reason    TEXT,                 -- 裁决说明（拒绝原因 / 冲突说明）
    conflict_with      TEXT,                 -- 冲突对象引用（现有事实的 PK；无冲突 → NULL）
    resulting_fact_id  TEXT,                 -- ACCEPTED 落地产物引用（如 Event.event_id；其余 → NULL）
    created_at         INTEGER NOT NULL      -- epoch 毫秒
);

CREATE INDEX idx_candidate_fact_history ON CandidateFact(history_id);
CREATE INDEX idx_candidate_fact_status ON CandidateFact(status);

insertCandidateFact:
INSERT OR REPLACE INTO CandidateFact(candidate_id, history_id, commit_id, novel_id, variant_id, scope, chapter_id,
                                     kind, operation, fact_name, summary, source_excerpt, reason, status,
                                     decision_reason, conflict_with, resulting_fact_id, created_at)
VALUES (:candidate_id, :history_id, :commit_id, :novel_id, :variant_id, :scope, :chapter_id,
        :kind, :operation, :fact_name, :summary, :source_excerpt, :reason, :status,
        :decision_reason, :conflict_with, :resulting_fact_id, :created_at);

getCandidateFactById:
SELECT * FROM CandidateFact WHERE candidate_id = :candidate_id;

listCandidateFactsByHistory:
SELECT * FROM CandidateFact WHERE history_id = :history_id ORDER BY created_at ASC, candidate_id ASC;

listCandidateFactsByStatus:
SELECT * FROM CandidateFact WHERE status = :status ORDER BY created_at ASC, candidate_id ASC;

updateCandidateFactStatus:
UPDATE CandidateFact
SET status = :status, decision_reason = :decision_reason, conflict_with = :conflict_with,
    resulting_fact_id = :resulting_fact_id
WHERE candidate_id = :candidate_id;
