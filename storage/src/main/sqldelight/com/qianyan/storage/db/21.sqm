-- I13 · Schema v22（21.sqm：v21 → v22）
-- additive migration：仅新增 TaskQueueItem 表（Task 的调度条目）+ 领取扫描索引。
-- 不修改任何既有表 / 列 / 语义；无 backfill、无既有数据转换。
-- 幂等由 DatabaseInitializer 的 !tableExists("TaskQueueItem") 分支包裹。

CREATE TABLE IF NOT EXISTS TaskQueueItem (
    queue_item_id     TEXT NOT NULL PRIMARY KEY,
    task_id           TEXT NOT NULL,
    project_id        TEXT NOT NULL,
    kind              TEXT NOT NULL,
    priority          TEXT NOT NULL,
    status            TEXT NOT NULL,
    queued_at         INTEGER NOT NULL,
    available_at      INTEGER NOT NULL,
    attempt           INTEGER NOT NULL DEFAULT 0,
    max_attempts      INTEGER NOT NULL DEFAULT 3 CHECK (max_attempts >= 1),
    paused            INTEGER NOT NULL DEFAULT 0,
    cancel_requested  INTEGER NOT NULL DEFAULT 0,
    claimed_by        TEXT,
    claimed_at        INTEGER,
    last_error        TEXT,
    UNIQUE (task_id),
    FOREIGN KEY (task_id) REFERENCES Task(task_id)
);

CREATE INDEX IF NOT EXISTS idx_task_queue_claim ON TaskQueueItem(project_id, status, paused, available_at);